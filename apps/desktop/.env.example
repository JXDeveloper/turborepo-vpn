# Copy to apps/desktop/.env — the real file is gitignored, never commit it.
# electron-vite (Vite) inlines VITE_* vars into the renderer at build/dev time.

# API base the renderer calls. Either point directly at the exit-node API:
VITE_WEB_API_URL=http://127.0.0.1:3001/api
# ...or at the web app (uses ${VITE_WEB_APP_URL}/api) — overrides the
# window.location.origin fallback when set:
# VITE_WEB_APP_URL=https://your-web-app.example.com

# Clerk (electron)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
