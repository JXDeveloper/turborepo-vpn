#!/bin/bash
set -e

# Update databases
if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# Reload systemd
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

# Purge configuration files, services, and policies
if [ "$1" = "purge" ]; then
    echo "Purging MyCompany VPN files and configurations..."

    # Remove native binaries and directories
    rm -rf '/usr/lib/mycompany' || true

    # Remove systemd service
    rm -f '/usr/lib/systemd/system/com.mycompany.vpn.service' || true

    # Remove D-Bus config
    rm -f '/etc/dbus-1/system.d/com.mycompany.vpn.conf' || true

    # Remove Polkit policy
    rm -f '/usr/share/polkit-1/actions/com.mycompany.vpn.policy' || true

    # Remove AppArmor profile
    rm -f '/etc/apparmor.d/metro-vpn' || true

    # Remove WireGuard config files and keys stored by the daemon
    rm -rf '/etc/mycompany-vpn' || true

    # Reload systemd configuration again
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
fi
