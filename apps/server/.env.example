# Copy to apps/server/.env — the real file is gitignored, never commit it.
# Production reads the same keys from /etc/metro-vpn/exit-node.env instead
# (see deployment/vpn-exit-node.service and the CI workflow).

# HTTP port for the control API (put Caddy in front for HTTPS: deployment/Caddyfile)
PORT=3001

# REQUIRED. HMAC secret shared with apps/web — the server refuses to start without it.
BACKEND_API_SECRET=change-me

# Public WireGuard endpoint handed to clients, e.g. 203.0.113.10:51820
# On EC2 the auto-detected address is a private VPC IP — set this explicitly.
WG_ENDPOINT=

# NAT masquerade interface (auto-detected from the default route if empty)
WG_WAN_INTERFACE=

# Fallback server public key (read from configs/wg0.conf when available)
WG_SERVER_PUBLIC_KEY=

# WireGuard config the server manages (default: ./configs/wg0.conf).
# Production MUST keep it outside /opt/releases/<sha>: the deploy pipeline does
# not ship configs/ and symlinks a fresh release directory on every deploy, so
# a config inside it would mean a new server keypair (and zero peers) per
# release. CI sets /var/lib/metro-vpn/configs/wg0.conf.
WG_CONFIG_PATH=

# Bring the interface up on boot and reconcile its peers from the config.
# Defaults to true when NODE_ENV=production, false otherwise (bringing it up
# needs root). Set to false to keep the interface under manual control.
WG_AUTO_UP=false

NODE_ENV=development
