# Copy to apps/web/.env.local — real env files are gitignored, never commit them.

# --- Exit-node API ---
# Base URL including the /api prefix.
# Dev default: http://127.0.0.1:3001/api
# Prod (behind Caddy HTTPS): https://api.yourdomain.com/api
VPN_API_URL=

# REQUIRED. Must match the exit-node server's BACKEND_API_SECRET —
# used to HMAC-sign mutating requests.
BACKEND_API_SECRET=change-me

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- CORS for /api/vpn/peer/create (desktop/dev clients) ---
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGIN=http://localhost:5173,my-vpn://renderer

# --- Dev-only: extra origins allowed to request `next dev` (comma-separated) ---
ALLOWED_DEV_ORIGINS=

# --- Clerk (also declared in turbo.json globalEnv) ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
